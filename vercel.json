{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/email-automation/run",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/feishu-mail-sync/run",
      "schedule": "0 */6 * * *"
    }
  ]
}
